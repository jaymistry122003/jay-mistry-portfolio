---
const whatIWorkAcross = [
  {
    domain: "DATA ANALYTICS",
    skills: ["SQL", "Python", "EDA", "Data Cleaning", "Statistical Analysis"]
  },
  {
    domain: "BUSINESS INTELLIGENCE",
    skills: ["Power BI", "DAX", "Dashboard Development", "KPI Analysis", "Business Reporting"]
  },
  {
    domain: "BUSINESS ANALYSIS",
    skills: ["Requirements Analysis", "Business Performance Analysis", "Root Cause Analysis", "Trend Analysis", "Data-Driven Decision Making"]
  },
  {
    domain: "TECHNICAL & SYSTEMS",
    skills: ["PostgreSQL", "MySQL", "ETL", "Data Warehousing", "Database Design"]
  },
  {
    domain: "COMMUNICATION",
    skills: ["Stakeholder Communication", "Data Storytelling", "Insight Presentation", "Cross-Functional Collaboration"]
  }
];
---

<section id="about" class="py-16 sm:py-24 border-b border-white/10 text-left relative">
  
  {/* Subtle Ambient Background Grid & Glow Accent */}
  <div class="absolute inset-0 opacity-[0.03] bg-[linear-gradient(to_right,#ffffff_1px,transparent_1px),linear-gradient(to_bottom,#ffffff_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 relative z-10">
    
    {/* Section Header */}
    <div class="space-y-3 max-w-3xl scroll-reveal">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md text-xs font-mono font-bold text-yellow-400 bg-yellow-500/10 border border-yellow-500/30">
        <span class="w-1.5 h-1.5 rounded-full bg-yellow-400 animate-pulse"></span>
        <span>[SYS_PROFILE] • ABOUT & ANALYTICAL BACKGROUND</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
        Bridging Data, Technology & <span class="text-yellow-400">Business Decisions</span>.
      </h2>
      <p class="text-base text-slate-400 max-w-2xl font-normal leading-relaxed">
        Combining computer science technical fundamentals with business analytics, Power BI reporting, and data-driven decision-making.
      </p>
    </div>

    {/* Editorial Split Layout (LEFT: Narrative | RIGHT: Key Profile Details) */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      {/* LEFT: Short Human Narrative (Slides in from Left) */}
      <div class="lg:col-span-7 space-y-5 text-sm sm:text-base text-slate-300 leading-relaxed font-normal bg-[#0f1118]/90 backdrop-blur-md p-6 sm:p-8 rounded-xl border border-white/10 shadow-xl hover-card-product scroll-reveal-left">
        
        <div class="flex items-center justify-between border-b border-white/10 pb-3">
          <span class="text-xs font-mono font-bold text-yellow-400 tracking-wider">
            PROFILE SUMMARY
          </span>
          <span class="text-[10px] font-mono text-slate-500">
            [SYS_VERIFIED]
          </span>
        </div>

        <p class="text-white font-medium text-base sm:text-lg">
          I started with a technical foundation in <strong class="text-yellow-400 font-bold">Computer Science and Engineering (Core)</strong> at Parul University.
        </p>

        <p>
          Through practical experience and project execution, I developed a strong analytical focus on understanding how structured data can support operational business decisions and insight generation.
        </p>

        <p>
          I am currently pursuing a <strong class="text-white font-bold">PGCM in Business Analytics</strong> from MIT School of Distance Education, Pune, to further deepen that business and analytical framework.
        </p>

        <p>
          My day-to-day work combines hands-on technical execution—using <span class="text-yellow-300 font-mono">SQL</span>, <span class="text-yellow-300 font-mono">Python</span>, <span class="text-yellow-300 font-mono">Power BI</span>, <span class="text-yellow-300 font-mono">relational databases</span>, and <span class="text-yellow-300 font-mono">data cleaning</span>—with business performance analysis, trend identification, stakeholder communication, and AI-assisted analytics workflows.
        </p>

        <div class="pt-3 border-t border-white/10">
          <p class="text-xs font-mono text-yellow-400 font-semibold flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-yellow-400"></span>
            <span>Goal: To work in roles bridging the gap between data, technology, and business decisions.</span>
          </p>
        </div>

      </div>

      {/* RIGHT: Key Profile Highlights (Slides in from Right with Stagger) */}
      <div class="lg:col-span-5 space-y-4 scroll-reveal-right">
        
        {/* Education Card */}
        <div class="p-4 rounded-xl bg-[#0f1118]/80 backdrop-blur-md border border-white/10 space-y-1 hover-card-product scroll-reveal-scale" data-delay="100">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-mono text-slate-500 uppercase tracking-wider block">TECHNICAL FOUNDATION</span>
            <span class="text-[10px] font-mono text-yellow-400 font-semibold">EDUCATION</span>
          </div>
          <span class="font-bold text-white text-sm block pt-0.5">B.Tech – Computer Science & Engineering (Core)</span>
          <span class="text-xs font-mono text-slate-400 block">Parul University, Vadodara • 2021–2025</span>
        </div>

        {/* Current Education Card */}
        <div class="p-4 rounded-xl bg-[#0f1118]/80 backdrop-blur-md border border-yellow-500/30 space-y-1 hover-card-product shadow-[0_0_15px_rgba(234,179,8,0.08)] scroll-reveal-scale" data-delay="180">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-mono text-slate-500 uppercase tracking-wider block">BUSINESS CREDENTIAL</span>
            <span class="text-[10px] font-mono text-yellow-400 font-semibold">PURSUING</span>
          </div>
          <span class="font-bold text-yellow-400 text-sm block pt-0.5">PGCM – Business Analytics</span>
          <span class="text-xs font-mono text-slate-400 block">MIT School of Distance Ed., Pune • 2026–2027</span>
        </div>

        {/* Communication Score Card */}
        <div class="p-4 rounded-xl bg-[#0f1118]/80 backdrop-blur-md border border-white/10 space-y-1 hover-card-product scroll-reveal-scale" data-delay="260">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-mono text-slate-500 uppercase tracking-wider block">ENGLISH PROFICIENCY</span>
            <span class="text-[10px] font-mono text-yellow-400 font-semibold">VERIFIED</span>
          </div>
          <div class="flex items-baseline justify-between pt-0.5">
            <span class="font-bold text-white text-sm">PTE Academic Assessment</span>
            <span class="font-mono text-xs font-bold text-yellow-400 bg-yellow-500/10 px-2 py-0.5 rounded border border-yellow-500/30">83 / 90 Score</span>
          </div>
        </div>

        {/* Current Focus Card */}
        <div class="p-4 rounded-xl bg-[#0f1118]/80 backdrop-blur-md border border-white/10 space-y-1 hover-card-product scroll-reveal-scale" data-delay="340">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-mono text-slate-500 uppercase tracking-wider block">TARGET ROLES</span>
            <span class="text-[10px] font-mono text-yellow-400 font-semibold">CURRENT FOCUS</span>
          </div>
          <span class="font-bold text-white text-sm block pt-0.5">Data / Business / BI / AI Analytics</span>
        </div>

      </div>

    </div>

    {/* BELOW: "WHAT I WORK ACROSS" Subsection */}
    <div class="pt-6 border-t border-white/10 space-y-6 scroll-reveal">
      
      <div class="flex items-center justify-between">
        <div class="space-y-1">
          <h3 class="text-lg font-bold text-white font-mono uppercase tracking-wider flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-yellow-400"></span>
            <span>What I Work Across</span>
          </h3>
          <p class="text-xs font-mono text-slate-400">
            Functional analytical capabilities supported by formal education and practical projects.
          </p>
        </div>
        <span class="hidden sm:inline-block text-[11px] font-mono text-slate-500">[ANALYTICAL_TOOLSTACK]</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {whatIWorkAcross.map((item, idx) => (
          <div class="p-5 rounded-xl bg-[#0f1118]/80 backdrop-blur-md border border-white/10 hover:border-yellow-500/40 transition-colors space-y-3 hover-card-product scroll-reveal-scale" data-delay={idx * 80}>
            <div class="flex items-center justify-between border-b border-white/10 pb-2">
              <span class="text-xs font-mono font-bold text-yellow-400 uppercase tracking-wider">
                {item.domain}
              </span>
              <span class="w-1 h-1 rounded-full bg-yellow-400/80"></span>
            </div>
            <div class="flex flex-wrap gap-1.5 pt-1">
              {item.skills.map((skill) => (
                <span class="px-2.5 py-1 rounded text-xs font-mono bg-[#161924] text-slate-200 border border-white/10">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>

    </div>

    {/* Section Navigation CTA */}
    <div class="pt-4 flex flex-wrap items-center justify-between gap-4 border-t border-white/10 text-xs font-mono scroll-reveal">
      <span class="text-slate-500">EXPLORE PORTFOLIO SECTIONS:</span>
      <div class="flex flex-wrap items-center gap-4">
        <a href="#projects" class="text-yellow-400 hover:text-yellow-300 font-semibold link-editorial flex items-center gap-1.5">
          <span>View Case Studies & Projects</span>
          <span>→</span>
        </a>
        <a href="#experience" class="text-slate-400 hover:text-yellow-400 font-semibold link-editorial flex items-center gap-1.5">
          <span>Explore Career History</span>
          <span>→</span>
        </a>
      </div>
    </div>

  </div>
</section>
