---
import { resumeData } from '../data/resumeData';

const langData = resumeData.languageCommunication;
---

<section id="communication" class="py-16 sm:py-24 border-b border-white/10 text-left">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    
    {/* Section Header */}
    <div class="space-y-3 max-w-3xl scroll-reveal">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md text-xs font-mono font-bold text-yellow-400 bg-yellow-500/10 border border-yellow-500/30">
        <span class="w-1.5 h-1.5 rounded-full bg-yellow-400 animate-pulse"></span>
        <span>COMMUNICATION & LANGUAGE PROFICIENCY</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
        Professional English & <span class="text-yellow-400">Communication</span>.
      </h2>
      <p class="text-base text-slate-400 max-w-2xl font-normal leading-relaxed">
        Demonstrated high-level technical communication qualification for analytical reporting, presentations, and stakeholder collaboration.
      </p>
    </div>

    {/* Clean Dark Metric Treatment with Scroll Reveal */}
    <div class="bg-[#0f1118]/90 backdrop-blur-md border border-yellow-500/30 rounded-xl p-6 sm:p-10 space-y-8 shadow-[0_0_20px_rgba(234,179,8,0.1)] scroll-reveal-scale">
      
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 pb-6">
        <div class="space-y-1">
          <span class="font-mono text-xs text-slate-400 uppercase tracking-wider block">Official Assessment</span>
          <h3 class="text-xl font-bold text-white">{langData.testName} Academic</h3>
        </div>

        {/* Clean Dark Metric Callout */}
        <div class="flex items-baseline gap-2 bg-[#090a0d] px-6 py-3 rounded-lg border border-yellow-500/30">
          <span class="text-slate-400 font-mono text-xs">Overall Score:</span>
          <span id="pte-score-display" class="text-3xl font-extrabold font-mono text-yellow-400">
            {langData.overallScore}
          </span>
          <span class="text-slate-400 font-mono text-sm">/ {langData.maxScore}</span>
        </div>
      </div>

      {/* Description & Highlights */}
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
        <div class="md:col-span-6 text-sm text-slate-300 leading-relaxed font-normal">
          <p>{langData.details}</p>
        </div>

        <div class="md:col-span-6 space-y-2 font-mono text-xs text-slate-300">
          {langData.highlights.map((h) => (
            <div class="flex items-center gap-2.5 bg-[#090a0d] p-3 rounded-md border border-white/10">
              <span class="w-1.5 h-1.5 rounded-full bg-yellow-400 shrink-0"></span>
              <span>{h}</span>
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>
</section>

{/* Restrained Count-Up Script */}
<script>
  function animateScore() {
    const scoreElement = document.getElementById('pte-score-display');
    if (!scoreElement) return;

    const target = 83;
    let current = 0;
    const duration = 1000;
    const stepTime = Math.abs(Math.floor(duration / target));

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      scoreElement.textContent = target.toString();
      return;
    }

    const timer = setInterval(() => {
      current += 1;
      scoreElement.textContent = current.toString();
      if (current >= target) {
        scoreElement.textContent = target.toString();
        clearInterval(timer);
      }
    }, stepTime);
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        animateScore();
        observer.disconnect();
      }
    });
  }, { threshold: 0.5 });

  const section = document.getElementById('communication');
  if (section) observer.observe(section);
</script>
