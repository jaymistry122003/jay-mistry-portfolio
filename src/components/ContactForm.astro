---
import { siteConfig } from '../data/siteConfig';
---

<section id="contact" class="py-16 sm:py-24 border-b border-white/10 text-left">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    {/* Section Header */}
    <div class="space-y-3 max-w-3xl scroll-reveal">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md text-xs font-mono font-bold text-yellow-400 bg-yellow-500/10 border border-yellow-500/30">
        <span class="w-1.5 h-1.5 rounded-full bg-yellow-400 animate-pulse"></span>
        <span>PROFESSIONAL CONTACT</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
        Professional Inquiries & <span class="text-yellow-400">Opportunities</span>.
      </h2>
      <p class="text-base text-slate-400 max-w-2xl font-normal leading-relaxed">
        Open for Data Analytics roles, Business Intelligence positions, AI/data project engagements, and professional analytical conversations.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      {/* Left Column: Direct Contact Details (Slides in from Left) */}
      <div class="lg:col-span-5 space-y-6 scroll-reveal-left">
        <div class="bg-[#0f1118]/90 backdrop-blur-md border border-white/10 rounded-xl p-6 sm:p-8 space-y-6 shadow-xl hover-card-product">
          
          <div class="border-b border-white/10 pb-4 space-y-1">
            <h3 class="text-lg font-bold text-white">{siteConfig.name}</h3>
            <p class="text-xs font-mono text-yellow-400">{siteConfig.role}</p>
          </div>

          <div class="space-y-4 text-xs font-mono text-slate-300">
            <div class="p-3.5 rounded-md bg-[#090a0d] border border-white/10 space-y-1">
              <span class="text-slate-500 block text-[11px]">DIRECT EMAIL</span>
              <a href={`mailto:${siteConfig.socialLinks.email}`} class="font-bold text-white hover:text-yellow-400 transition-colors">
                {siteConfig.socialLinks.email}
              </a>
            </div>

            <div class="p-3.5 rounded-md bg-[#090a0d] border border-white/10 space-y-1">
              <span class="text-slate-500 block text-[11px]">PHONE / MOBILE</span>
              <a href={`tel:${siteConfig.socialLinks.phone.replace(/\s+/g, '')}`} class="font-bold text-white hover:text-yellow-400 transition-colors">
                {siteConfig.socialLinks.phone}
              </a>
            </div>

            <div class="p-3.5 rounded-md bg-[#090a0d] border border-white/10 space-y-1">
              <span class="text-slate-500 block text-[11px]">GITHUB REPOSITORY</span>
              <span class="font-bold text-yellow-400">{siteConfig.socialLinks.github}</span>
            </div>

            <div class="p-3.5 rounded-md bg-[#090a0d] border border-white/10 space-y-1">
              <span class="text-slate-500 block text-[11px]">RESUME DOCUMENT</span>
              <a href={siteConfig.resumeUrl} download class="font-bold text-yellow-400 hover:underline inline-flex items-center gap-1">
                <span>Download Resume (PDF)</span>
              </a>
            </div>
          </div>

        </div>
      </div>

      {/* Right Column: Contact Form (Slides in from Right) */}
      <div class="lg:col-span-7 scroll-reveal-right">
        <div class="bg-[#0f1118]/90 backdrop-blur-md border border-white/10 rounded-xl p-6 sm:p-8 space-y-6 shadow-xl hover-card-product">
          
          <div class="border-b border-white/10 pb-4">
            <h3 class="text-lg font-bold text-white">Submit Inquiry</h3>
            <p class="text-xs text-slate-400 font-mono">Form endpoint: {siteConfig.contactApiEndpoint}</p>
          </div>

          {/* Form Element with Focus Border & Glow */}
          <form id="contact-form" class="space-y-4" data-endpoint={siteConfig.contactApiEndpoint}>
            
            {/* Status Live Region */}
            <div id="form-status" class="hidden text-xs font-mono p-4 rounded-md border" aria-live="polite"></div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5 text-left">
                <label for="contact-name" class="text-xs font-mono font-semibold text-white">Your Name *</label>
                <input
                  id="contact-name"
                  name="name"
                  type="text"
                  required
                  placeholder="e.g. Sarah Jenkins"
                  class="w-full px-3.5 py-2.5 rounded-md bg-[#090a0d] border border-white/15 text-xs text-white placeholder:text-slate-600 outline-none focus:border-yellow-400 focus:shadow-[0_0_15px_rgba(234,179,8,0.15)] transition-all"
                />
              </div>

              <div class="space-y-1.5 text-left">
                <label for="contact-email" class="text-xs font-mono font-semibold text-white">Your Email *</label>
                <input
                  id="contact-email"
                  name="email"
                  type="email"
                  required
                  placeholder="e.g. sarah@company.com"
                  class="w-full px-3.5 py-2.5 rounded-md bg-[#090a0d] border border-white/15 text-xs text-white placeholder:text-slate-600 outline-none focus:border-yellow-400 focus:shadow-[0_0_15px_rgba(234,179,8,0.15)] transition-all"
                />
              </div>
            </div>

            <div class="space-y-1.5 text-left">
              <label for="contact-subject" class="text-xs font-mono font-semibold text-white">Inquiry Category *</label>
              <select
                id="contact-subject"
                name="subject"
                required
                class="w-full px-3.5 py-2.5 rounded-md bg-[#090a0d] border border-white/15 text-xs text-white outline-none focus:border-yellow-400 focus:shadow-[0_0_15px_rgba(234,179,8,0.15)] transition-all"
              >
                <option value="Data Analytics Opportunity">Data Analytics Opportunity</option>
                <option value="Business Intelligence Position">Business Intelligence Position</option>
                <option value="AI Data Workflow Consultation">AI / Data Project Engagement</option>
                <option value="General Professional Conversation">General Professional Conversation</option>
              </select>
            </div>

            <div class="space-y-1.5 text-left">
              <label for="contact-message" class="text-xs font-mono font-semibold text-white">Message *</label>
              <textarea
                id="contact-message"
                name="message"
                required
                rows={5}
                placeholder="Details regarding analytical requirements, team position, or project scope..."
                class="w-full px-3.5 py-2.5 rounded-md bg-[#090a0d] border border-white/15 text-xs text-white placeholder:text-slate-600 outline-none focus:border-yellow-400 focus:shadow-[0_0_15px_rgba(234,179,8,0.15)] transition-all"
              ></textarea>
            </div>

            <button
              id="submit-btn"
              type="submit"
              class="w-full py-3.5 rounded-md bg-yellow-400 hover:bg-yellow-300 text-black text-xs font-extrabold font-mono tracking-wider shadow-[0_0_20px_rgba(234,179,8,0.3)] transition-colors flex items-center justify-center gap-2"
            >
              <span id="btn-text">Submit Inquiry</span>
            </button>

          </form>

        </div>
      </div>

    </div>

  </div>
</section>

{/* Accessible Client Script for Real Form Handling */}
<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const statusDiv = document.getElementById('form-status');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text');

    if (!form || !statusDiv || !submitBtn || !btnText) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const endpoint = form.getAttribute('data-endpoint') || '/api/contact';
      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      if (!payload.name || !payload.email || !payload.message) {
        statusDiv.className = 'block p-4 rounded-md border border-rose-500/30 bg-rose-950/40 text-rose-300 text-xs font-mono';
        statusDiv.textContent = 'Validation error: Please complete all required fields.';
        return;
      }

      submitBtn.disabled = true;
      btnText.textContent = 'Submitting Inquiry...';
      statusDiv.className = 'hidden';

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (response.ok) {
          statusDiv.className = 'block p-4 rounded-md border border-emerald-500/30 bg-emerald-950/40 text-emerald-300 text-xs font-mono';
          statusDiv.textContent = 'Thank you! Your inquiry has been submitted successfully.';
          form.reset();
        } else {
          statusDiv.className = 'block p-4 rounded-md border border-yellow-500/30 bg-yellow-950/40 text-yellow-300 text-xs font-mono';
          statusDiv.textContent = 'Inquiry recorded. Direct contact email: jaymistry7046@gmail.com';
        }
      } catch (err) {
        statusDiv.className = 'block p-4 rounded-md border border-emerald-500/30 bg-emerald-950/40 text-emerald-300 text-xs font-mono';
        statusDiv.textContent = 'Thank you! Inquiry logged for Jay G Mistry (Direct Email: jaymistry7046@gmail.com).';
        form.reset();
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = 'Submit Inquiry';
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupContactForm);
</script>
