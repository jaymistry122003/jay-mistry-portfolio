---
import { resumeData } from '../data/resumeData';

const educationList = resumeData.education;
---

<section id="education" class="py-16 sm:py-24 border-b border-white/10 text-left">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    {/* Section Header */}
    <div class="space-y-3 max-w-3xl scroll-reveal">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md text-xs font-mono font-bold text-yellow-400 bg-yellow-500/10 border border-yellow-500/30">
        <span class="w-1.5 h-1.5 rounded-full bg-yellow-400 animate-pulse"></span>
        <span>ACADEMIC BACKGROUND</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
        Education & <span class="text-yellow-400">Qualifications</span>.
      </h2>
      <p class="text-base text-slate-400 max-w-2xl font-normal leading-relaxed">
        Formal academic credentials in Computer Science & Engineering (Core) and Post-Graduate Business Analytics.
      </p>
    </div>

    {/* Education Grid with Staggered Entrance */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      {educationList.map((edu, idx) => (
        <div 
          class="bg-[#0f1118]/80 backdrop-blur-md border border-white/10 hover:border-yellow-500/40 rounded-xl p-6 sm:p-8 space-y-4 shadow-lg transition-all duration-200 hover-lift scroll-reveal-scale"
          data-delay={idx * 100}
        >
          <div class="flex items-center justify-between border-b border-white/10 pb-3">
            <span class="font-mono text-xs font-bold text-yellow-400 uppercase tracking-wider flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-yellow-400"></span>
              <span>{edu.status}</span>
            </span>
            <span class="font-mono text-xs text-yellow-400 bg-yellow-500/10 px-2.5 py-1 rounded border border-yellow-500/30 font-semibold">
              {edu.period}
            </span>
          </div>

          <div class="space-y-1">
            <h3 class="text-xl font-extrabold text-white">
              {edu.degree}
            </h3>
            <p class="text-sm font-mono text-slate-300">
              {edu.institution}
            </p>
          </div>

          {edu.details && (
            <p class="text-xs text-slate-400 leading-relaxed pt-2 border-t border-white/10 font-mono">
              {edu.details}
            </p>
          )}
        </div>
      ))}
    </div>

  </div>
</section>
