---
import { projectsData } from '../data/projectsData';

const flagshipProject = projectsData.find(p => p.slug === 'ai-data-analyst-agent') || projectsData[0];
const healthlinkProject = projectsData.find(p => p.slug === 'healthlink-solutions') || projectsData[1];
---

<section id="projects" class="py-16 sm:py-24 border-b border-[#e6e5df] text-left">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    {/* Section Header */}
    <div class="space-y-3 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md text-xs font-mono font-medium text-[#800020] bg-[rgba(128,0,32,0.06)] border border-[rgba(128,0,32,0.2)]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#800020]"></span>
        <span>FLAGSHIP & FEATURED CASE STUDIES</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-[#121316] tracking-tight">
        Featured <span class="text-[#800020]">Analytical Case Studies</span>.
      </h2>
      <p class="text-base text-[#4a4d55] max-w-2xl font-normal leading-relaxed">
        Deep dives demonstrating how raw business data is transformed into strategic decisions, Power BI dashboards, and AI analytical systems.
      </p>
    </div>

    {/* Project 01: FLAGSHIP AI Data Analyst Agent (Higher Visual Weight) */}
    <div class="bg-white border-2 border-[#800020] rounded-lg p-6 sm:p-10 space-y-8 shadow-sm relative overflow-hidden group">
      
      {/* Editorial Header Bar */}
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#e6e5df] pb-6">
        <div class="flex items-center gap-3">
          <span class="font-mono text-sm font-bold text-[#800020] bg-[rgba(128,0,32,0.06)] px-2.5 py-1 rounded border border-[rgba(128,0,32,0.2)]">
            PROJECT 01
          </span>
          <span class="px-3 py-1 rounded-md text-xs font-mono font-semibold text-white bg-[#800020]">
            FLAGSHIP PROJECT
          </span>
          <span class="px-3 py-1 rounded-md text-xs font-mono font-semibold text-[#121316] bg-[#faf9f5] border border-[#e6e5df]">
            {flagshipProject.statusText}
          </span>
        </div>
        <span class="text-xs font-mono text-[#717580]">
          {flagshipProject.category}
        </span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <div class="lg:col-span-7 space-y-4">
          <h3 class="text-2xl sm:text-3xl font-extrabold text-[#121316] tracking-tight">
            <a href={`/projects/${flagshipProject.slug}`} class="hover:text-[#800020] transition-colors">
              {flagshipProject.title}
            </a>
          </h3>
          <p class="text-sm font-mono text-[#800020] font-semibold">
            {flagshipProject.subtitle}
          </p>
          <p class="text-sm sm:text-base text-[#4a4d55] leading-relaxed">
            {flagshipProject.shortDesc}
          </p>

          <div class="space-y-2 pt-2">
            <span class="text-xs font-mono font-bold text-[#121316] uppercase tracking-wider block">
              Core Analytical Objectives & Architecture:
            </span>
            <ul class="space-y-1.5 text-xs font-mono text-[#4a4d55]">
              {flagshipProject.summaryPoints.map((point) => (
                <li class="flex items-start gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#800020] shrink-0 mt-1.5"></span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        {/* Right Column: Visual Preview Container & CTAs */}
        <div class="lg:col-span-5 p-6 rounded-lg bg-[#faf9f5] border border-[#e6e5df] space-y-6">
          <div class="space-y-2">
            <span class="text-xs font-mono text-[#717580] uppercase tracking-wider block">Analytical Stack</span>
            <div class="flex flex-wrap gap-2">
              {flagshipProject.tools.map((t) => (
                <span class="px-2.5 py-1 rounded text-xs font-mono bg-white text-[#121316] border border-[#e6e5df]">
                  {t}
                </span>
              ))}
            </div>
          </div>

          <div class="space-y-2 pt-4 border-t border-[#e6e5df]">
            <span class="text-xs font-mono text-[#717580] uppercase tracking-wider block">GitHub Repository</span>
            <a
              href={flagshipProject.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3.5 py-2 rounded-md bg-[#121316]/5 hover:bg-[#121316]/10 backdrop-blur-md border border-[#e6e5df] hover:border-yellow-500 text-xs font-semibold font-mono text-[#121316] hover:text-yellow-600 transition-all duration-200 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:ring-offset-1"
            >
              <svg class="w-4 h-4 text-yellow-500 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
              </svg>
              <span>GitHub Repository</span>
            </a>
          </div>

          <div class="pt-2 flex flex-col sm:flex-row gap-3">
            <a
              href={`/projects/${flagshipProject.slug}`}
              class="flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-md bg-[#800020] hover:bg-[#650019] text-white text-xs font-semibold font-mono shadow-sm transition-colors"
            >
              <span>View Case Study</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>

      </div>

    </div>

    {/* Project 02: Healthlink Solutions Power BI Analytics */}
    <div class="bg-white border border-[#e6e5df] hover:border-[#800020] rounded-lg p-6 sm:p-10 space-y-8 shadow-sm transition-all duration-200 hover-lift">
      
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#e6e5df] pb-6">
        <div class="flex items-center gap-3">
          <span class="font-mono text-sm font-bold text-[#800020] bg-[rgba(128,0,32,0.06)] px-2.5 py-1 rounded border border-[rgba(128,0,32,0.2)]">
            PROJECT 02
          </span>
          <span class="px-3 py-1 rounded-md text-xs font-mono font-semibold text-[#800020] bg-[rgba(128,0,32,0.06)] border border-[rgba(128,0,32,0.2)]">
            POWER BI BUSINESS CASE STUDY
          </span>
        </div>
        <span class="text-xs font-mono text-[#717580]">
          {healthlinkProject.category}
        </span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <div class="lg:col-span-7 space-y-4">
          <h3 class="text-2xl sm:text-3xl font-extrabold text-[#121316] tracking-tight">
            <a href={`/projects/${healthlinkProject.slug}`} class="hover:text-[#800020] transition-colors">
              {healthlinkProject.title}
            </a>
          </h3>
          <p class="text-sm font-mono text-[#800020] font-semibold">
            {healthlinkProject.subtitle}
          </p>
          <p class="text-sm sm:text-base text-[#4a4d55] leading-relaxed">
            {healthlinkProject.shortDesc}
          </p>

          {/* Strong Factual Metrics Display (2-3 Key Metrics visually) */}
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 text-xs font-mono">
            <div class="p-3 rounded-md bg-[#faf9f5] border border-[#e6e5df]">
              <span class="text-[#717580] block text-[11px]">Total Business</span>
              <span class="font-bold text-[#121316] mt-0.5 block text-sm">₹51.93L (+22.4%)</span>
            </div>
            <div class="p-3 rounded-md bg-[#faf9f5] border border-[#e6e5df]">
              <span class="text-[#717580] block text-[11px]">Doctor Outreach</span>
              <span class="font-bold text-[#121316] mt-0.5 block text-sm">2,290 Doctors</span>
            </div>
            <div class="p-3 rounded-md bg-[#faf9f5] border border-[#e6e5df]">
              <span class="text-[#717580] block text-[11px]">Completed Calls</span>
              <span class="font-bold text-[#800020] mt-0.5 block text-sm">9,519 Actual Calls</span>
            </div>
          </div>
        </div>

        {/* Right Side: Tools & Actions */}
        <div class="lg:col-span-5 p-6 rounded-lg bg-[#faf9f5] border border-[#e6e5df] space-y-6">
          <div class="space-y-2">
            <span class="text-xs font-mono text-[#717580] uppercase tracking-wider block">Analytical Stack</span>
            <div class="flex flex-wrap gap-2">
              {healthlinkProject.tools.map((t) => (
                <span class="px-2.5 py-1 rounded text-xs font-mono bg-white text-[#121316] border border-[#e6e5df]">
                  {t}
                </span>
              ))}
            </div>
          </div>



          <div class="pt-2">
            <a
              href={`/projects/${healthlinkProject.slug}`}
              class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-md bg-[#800020] hover:bg-[#650019] text-white text-xs font-semibold font-mono shadow-sm transition-colors"
            >
              <span>View Case Study</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
