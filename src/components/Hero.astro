---
import { siteConfig } from '../data/siteConfig';
---

<section id="hero" class="py-12 sm:py-20 border-b border-white/10 text-left relative overflow-hidden">
  
  {/* Subtle Ambient Yellow Signal Glow */}
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-80 h-80 bg-yellow-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      {/* Left Column: Positioning & Copy */}
      <div class="lg:col-span-7 space-y-6">
        
        {/* System Protocol Status Badge */}
        <div class="hero-stagger-1">
          <div class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full text-xs font-mono font-bold text-yellow-400 bg-yellow-500/10 border border-yellow-500/30 shadow-[0_0_15px_rgba(234,179,8,0.15)]">
            <span class="w-2 h-2 rounded-full bg-yellow-400 animate-pulse"></span>
            <span>SYSTEM ACTIVE • DATA / BI / AI ANALYST PROTOCOL</span>
          </div>
        </div>

        {/* Candidate Identity */}
        <div class="space-y-2 hero-stagger-2">
          <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-[1.08]">
            {siteConfig.name}
          </h1>
          <p class="text-lg sm:text-xl font-mono text-yellow-400 font-semibold tracking-wide">
            {siteConfig.role}
          </p>
        </div>

        {/* Editorial Headline with Selective Yellow Signal Highlight */}
        <div class="hero-stagger-3">
          <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight leading-[1.18] text-slate-100">
            Turning Complex Operational Data into <span class="text-yellow-400 relative inline-block">Strategic Business Decisions<span class="absolute bottom-0 left-0 w-full h-[3px] bg-yellow-400/80 rounded-full"></span></span>.
          </h2>
        </div>

        {/* Supporting Copy */}
        <div class="hero-stagger-4">
          <p class="text-base text-slate-300 leading-relaxed max-w-xl font-normal">
            Specialized in business intelligence, SQL database modeling, Power BI dashboard architecture, and autonomous AI data analysis workflows.
          </p>
        </div>

        {/* CTAs */}
        <div class="pt-2 flex flex-wrap items-center gap-4 hero-stagger-4">
          <a
            href="#projects"
            class="group inline-flex items-center gap-2 px-6 py-3.5 rounded-md bg-yellow-400 hover:bg-yellow-300 text-black font-mono text-xs font-extrabold tracking-wider shadow-[0_0_20px_rgba(234,179,8,0.3)] hover:shadow-[0_0_30px_rgba(234,179,8,0.55)] hover:-translate-y-0.5 transition-all duration-200"
          >
            <span>View Portfolio Projects</span>
            <span class="group-hover:translate-x-1 transition-transform duration-200">→</span>
          </a>

          <a
            href={siteConfig.resumeUrl}
            download
            class="group inline-flex items-center gap-2 px-6 py-3.5 rounded-md bg-[#0f1118]/80 hover:bg-[#161924] text-white border border-white/15 hover:border-yellow-400/80 hover:text-yellow-400 text-xs font-mono font-semibold hover:shadow-[0_0_20px_rgba(234,179,8,0.2)] hover:-translate-y-0.5 transition-all duration-200"
          >
            <svg class="w-3.5 h-3.5 text-yellow-400 group-hover:translate-y-0.5 transition-transform duration-200" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Download Resume (PDF)</span>
          </a>

          <a
            href="#contact"
            class="group inline-flex items-center gap-1.5 text-xs font-mono font-semibold text-slate-300 hover:text-yellow-400 transition-colors link-editorial py-2"
          >
            <span>Let's Connect</span>
            <span class="group-hover:translate-x-1 transition-transform duration-200">→</span>
          </a>
        </div>

      </div>

      {/* Right Column: 3D Layered Subject Breakout Stage */}
      <div class="lg:col-span-5 hero-stagger-6">
        <div id="hero-stage" class="relative max-w-md mx-auto lg:max-w-none perspective-[1000px] select-none">
          
          {/* Layer 1: Hero Ambient Backlight Glow (z-1) */}
          <div id="hero-glow" class="absolute -inset-4 rounded-3xl bg-gradient-to-b from-yellow-500/20 via-yellow-500/10 to-transparent blur-2xl opacity-70 pointer-events-none transition-transform duration-500 ease-out z-0"></div>

          {/* Layer 2: Glass Container Card Frame (z-5) */}
          <div id="hero-card" class="p-6 rounded-2xl bg-[#0f1118]/90 backdrop-blur-xl border border-yellow-500/30 shadow-[0_15px_40px_rgba(0,0,0,0.8)] space-y-4 relative z-10 transition-transform duration-500 ease-out">
            
            {/* Terminal Top Bar */}
            <div class="flex items-center justify-between border-b border-white/10 pb-3">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
                <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
              </div>
              <span class="text-[11px] font-mono text-yellow-400 font-bold">
                [jay_mistry_analytics.py]
              </span>
            </div>

            {/* Layer 3 & 4: 3D Subject Breakout Stage */}
            <div class="relative pt-8 pb-1 px-3 group cursor-pointer overflow-visible">
              
              {/* Layer 3: Inner Frame Box with Original Photo Contained Inside (z-5) */}
              <div id="hero-inner-frame" class="relative w-full h-[220px] sm:h-[260px] rounded-xl bg-[#090a0d] border border-white/20 group-hover:border-yellow-500/50 shadow-inner transition-all duration-500 overflow-hidden z-10">
                <img
                  src="/resources/me.jpeg"
                  alt=""
                  aria-hidden="true"
                  class="w-full h-full object-cover object-top opacity-30 blur-[1px] scale-105 select-none pointer-events-none"
                />
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_40%,rgba(234,179,8,0.25),transparent_80%)]"></div>
              </div>

              {/* Layer 4: ONLY-ME SUBJECT CUTOUT (Transparent PNG Breaking OUT Over the Border) (z-20) */}
              <div class="absolute inset-x-0 -top-10 sm:-top-12 bottom-1 flex items-end justify-center pointer-events-none z-20 overflow-visible">
                <img
                  id="hero-cutout"
                  src="/resources/me_cutout.png"
                  alt="Jay G Mistry - Data / Business / BI / AI Analyst"
                  class="h-[270px] sm:h-[315px] max-w-none object-contain object-bottom transform-gpu transition-transform duration-300 ease-out drop-shadow-[0_15px_30px_rgba(0,0,0,0.85)] group-hover:drop-shadow-[0_20px_40px_rgba(234,179,8,0.4)] select-none pointer-events-auto"
                />
              </div>

              {/* Layer 5: Subtle Foreground Depth Glow Accent (z-30) */}
              <div class="absolute inset-x-8 -top-8 h-4 rounded-full bg-yellow-400/20 blur-md pointer-events-none z-30 opacity-70 group-hover:opacity-100 transition-opacity"></div>

            </div>

            {/* Live Terminal Metrics */}
            <div class="grid grid-cols-2 gap-2 text-xs font-mono pt-1">
              <div class="p-2.5 rounded-lg bg-[#090a0d] border border-white/10 text-slate-300">
                <span class="text-slate-500 block text-[10px]">ANALYTICAL STACK</span>
                <span class="font-bold text-yellow-400">SQL • BI • Python • AI</span>
              </div>
              <div class="p-2.5 rounded-lg bg-[#090a0d] border border-white/10 text-slate-300">
                <span class="text-slate-500 block text-[10px]">PTE ACADEMIC</span>
                <span class="font-bold text-yellow-400">83 / 90 Score</span>
              </div>
            </div>

          </div>

        </div>
      </div>

    </div>
  </div>
</section>

{/* Smooth 3D Mouse Parallax & Entrance Animation Script */}
<script>
  (function initHeroSubjectParallax() {
    const stage = document.getElementById('hero-stage');
    const cutout = document.getElementById('hero-cutout');
    const frame = document.getElementById('hero-inner-frame');
    const glow = document.getElementById('hero-glow');

    if (!stage || !cutout || !frame) return;

    stage.addEventListener('mousemove', (e) => {
      const rect = stage.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;

      // Layered depth movement: Cutout 24px, Frame 12px, Glow 4px
      cutout.style.transform = `translate3d(${x * 24}px, ${y * 24}px, 20px) scale(1.02)`;
      frame.style.transform = `translate3d(${x * 12}px, ${y * 12}px, 0px)`;
      if (glow) glow.style.transform = `translate3d(${x * 4}px, ${y * 4}px, -10px)`;
    });

    stage.addEventListener('mouseleave', () => {
      cutout.style.transform = 'translate3d(0px, 0px, 0px) scale(1)';
      frame.style.transform = 'translate3d(0px, 0px, 0px)';
      if (glow) glow.style.transform = 'translate3d(0px, 0px, 0px)';
    });
  })();
</script>
