---
import BaseLayout from './BaseLayout.astro';
import PresentationViewer from '../components/PresentationViewer.astro';

interface Props {
  frontmatter: {
    title: string;
    subtitle: string;
    category: string;
    isFlagship?: boolean;
    inDevelopment?: boolean;
    statusText?: string;
    role: string;
    tools: string[];
    metrics: string[];
    deliverables?: string[];
    githubUrl: string;
    liveUrl?: string;
    presentationUrl?: string;
    publishDate?: string;
  };
  prevProject?: { slug: string; title: string } | null;
  nextProject?: { slug: string; title: string } | null;
}

const { frontmatter, prevProject, nextProject } = Astro.props;

const hasValidGithub = frontmatter.githubUrl && frontmatter.githubUrl.startsWith('http');
const hasValidLive = frontmatter.liveUrl && frontmatter.liveUrl.startsWith('http') && frontmatter.liveUrl !== 'GITHUB_URL_HERE';

// Fallback deliverables if not explicitly specified in frontmatter
const defaultDeliverables = [
  'Interactive Executive Presentation Deck',
  'PostgreSQL Relational Database & SQL Business Queries',
  'End-to-End Data Cleaning & Analytics Pipeline',
  'Strategic Business & Operational Recommendations'
];

const deliverablesList = frontmatter.deliverables && frontmatter.deliverables.length > 0
  ? frontmatter.deliverables
  : defaultDeliverables;
---

<BaseLayout
  title={`${frontmatter.title} — Jay G Mistry Case Study`}
  description={`${frontmatter.title}: ${frontmatter.subtitle}`}
  type="article"
>
  <article class="py-8 sm:py-16 text-left space-y-12 max-w-4xl mx-auto px-4 sm:px-6">
    
    {/* 1. PROJECT HERO */}
    <div class="space-y-6">
      {/* Back Navigation Link */}
      <div>
        <a href="/#projects" class="inline-flex items-center gap-2 text-xs font-mono text-slate-400 hover:text-yellow-400 transition-colors link-editorial">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Back to All Case Studies</span>
        </a>
      </div>

      {/* Case Study Header */}
      <header class="space-y-6 border-b border-white/10 pb-8">
        
        <div class="flex flex-wrap items-center gap-3">
          <span class="px-3 py-1 rounded-md text-xs font-mono font-semibold text-yellow-400 bg-yellow-500/10 border border-yellow-500/30">
            {frontmatter.category}
          </span>

          {frontmatter.isFlagship && (
            <span class="px-3 py-1 rounded-md text-xs font-mono font-semibold text-black bg-yellow-400 shadow-[0_0_10px_rgba(234,179,8,0.4)]">
              FLAGSHIP PROJECT
            </span>
          )}

          {frontmatter.inDevelopment && (
            <span class="px-3 py-1 rounded-md text-xs font-mono font-semibold text-slate-200 bg-[#161924] border border-white/10 inline-flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-yellow-400 animate-pulse"></span>
              <span>{frontmatter.statusText || 'In Development'}</span>
            </span>
          )}
        </div>

        {/* Case Study Title & Subtitle */}
        <div class="space-y-2 hero-stagger-1">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md text-xs font-mono font-bold text-yellow-400 bg-yellow-500/10 border border-yellow-500/30">
            <span class="w-1.5 h-1.5 rounded-full bg-yellow-400 animate-pulse"></span>
            <span>CASE STUDY ANALYTICAL REPORT</span>
          </div>
          <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight hero-stagger-2">
            {frontmatter.title}
          </h1>
          <p class="text-lg sm:text-xl font-mono text-yellow-400 font-semibold hero-stagger-3">
            {frontmatter.subtitle}
          </p>
        </div>

        {/* Metadata Specification Grid */}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 pt-4 text-xs font-mono text-slate-300 hero-stagger-4">
          <div class="p-3.5 rounded-xl bg-[#0f1118] border border-white/10 hover-lift">
            <span class="text-slate-500 block text-[11px]">ROLE</span>
            <span class="font-bold text-white mt-0.5 block">{frontmatter.role}</span>
          </div>
          
          <div class="p-3.5 rounded-xl bg-[#0f1118] border border-white/10 hover-lift">
            <span class="text-slate-500 block text-[11px]">GITHUB REPOSITORY</span>
            <a
              href={frontmatter.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 mt-1.5 px-3 py-1.5 rounded-md bg-[#161924]/80 backdrop-blur-md border border-white/10 hover:border-yellow-400 text-slate-200 hover:text-yellow-400 text-xs font-semibold font-mono transition-all duration-200 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-yellow-400"
              title="Open GitHub Repository in a new tab"
            >
              <svg class="w-3.5 h-3.5 text-yellow-400 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
              </svg>
              <span>GitHub Repository</span>
            </a>
          </div>

          <div class="p-3.5 rounded-xl bg-[#0f1118] border border-white/10 sm:col-span-2 lg:col-span-1 hover-lift">
            <span class="text-slate-500 block text-[11px]">ANALYTICAL TOOLSTACK</span>
            <span class="font-semibold text-white mt-0.5 block">{frontmatter.tools.join(', ')}</span>
          </div>
        </div>
      </header>
    </div>

    {/* 2 & 3. KEY ANALYTICAL HIGHLIGHTS */}
    <section class="space-y-3 scroll-reveal">
      <div class="p-5 rounded-xl bg-[#0f1118] border border-yellow-500/30 space-y-3 shadow-[0_0_20px_rgba(234,179,8,0.08)]">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-yellow-400"></span>
          <span class="font-mono text-xs font-bold text-yellow-400 uppercase tracking-wider">
            Key Analytical Highlights
          </span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-mono text-slate-200">
          {frontmatter.metrics.map((metric, idx) => (
            <div 
              class="flex items-center gap-2.5 bg-[#090a0d] p-3 rounded-lg border border-white/10 scroll-reveal-scale hover-lift"
              data-delay={idx * 100}
            >
              <span class="w-1.5 h-1.5 rounded-full bg-yellow-400 shrink-0"></span>
              <span class="leading-snug">{metric}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* 4. MAJOR PROJECT DELIVERABLES */}
    <section class="space-y-3">
      <div class="p-5 rounded-xl bg-[#0f1118] border border-white/10 space-y-3">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-yellow-400"></span>
          <span class="font-mono text-xs font-bold text-slate-300 uppercase tracking-wider">
            Project Deliverables
          </span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs font-mono text-slate-200">
          {deliverablesList.map((item) => (
            <div class="flex items-center gap-2.5 bg-[#161924] p-3 rounded-lg border border-white/10">
              <svg class="w-4 h-4 text-yellow-400 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="leading-snug">{item}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* 5. DETAILED PRESENTATION (Interactive PDF Slide Viewer) */}
    {frontmatter.presentationUrl && (
      <section class="pt-4">
        <PresentationViewer
          pdfUrl={frontmatter.presentationUrl}
          title={frontmatter.title}
        />
      </section>
    )}

    {/* 6-11. WRITTEN DEEP-DIVE CASE STUDY (Executive Summary, Methodology, Insights, Recommendations) */}
    <section class="space-y-6 pt-6 border-t border-white/10">
      <div class="overflow-x-auto max-w-full">
        <div class="prose prose-invert max-w-none prose-headings:font-bold prose-headings:text-white prose-p:text-slate-300 prose-p:leading-relaxed prose-li:text-slate-300 prose-code:font-mono prose-code:text-yellow-400 prose-code:bg-[#161924] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-blockquote:border-l-yellow-400 prose-blockquote:text-slate-300 prose-blockquote:bg-[#0f1118] prose-blockquote:p-4 prose-blockquote:rounded-r-md prose-table:w-full prose-table:text-xs prose-td:border-white/10 prose-th:border-white/10 prose-th:text-white">
          <slot />
        </div>
      </div>
    </section>

    {/* 12. PROJECT LINKS / CTA ACTION BAR */}
    <div class="pt-8 border-t border-white/10 flex flex-wrap items-center justify-between gap-4 relative z-10">
      <a href="/#projects" class="px-5 py-2.5 rounded-md bg-[#0f1118] border border-white/15 hover:border-yellow-400 text-slate-200 hover:text-yellow-400 text-xs font-semibold font-mono transition-colors">
        ← Back to All Case Studies
      </a>

      <div class="flex flex-wrap items-center gap-3 relative z-10">
        {frontmatter.presentationUrl && (
          <a
            href={frontmatter.presentationUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 rounded-md bg-[#161924] border border-yellow-500/40 text-yellow-400 hover:bg-yellow-500/20 hover:border-yellow-400 text-xs font-semibold font-mono transition-colors inline-flex items-center gap-2"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
            <span>View Presentation (PDF) ↗</span>
          </a>
        )}

        {hasValidGithub ? (
          <a
            href={frontmatter.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md bg-[#161924]/80 backdrop-blur-md border border-white/20 hover:border-yellow-400 text-slate-200 hover:text-yellow-400 text-xs font-semibold font-mono transition-all duration-200 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-yellow-400 focus:ring-offset-2 focus:ring-offset-[#0d0e12] cursor-pointer relative z-20"
          >
            <svg class="w-4 h-4 text-yellow-400 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
            <span>GitHub Repository</span>
          </a>
        ) : (
          <span class="px-3 py-1.5 rounded bg-[#0f1118] border border-white/10 text-[11px] font-mono text-slate-400">
            Repository: {frontmatter.githubUrl}
          </span>
        )}

        {hasValidLive && (
          <a
            href={frontmatter.liveUrl}
            target="_blank"
            rel="noreferrer"
            class="px-5 py-2.5 rounded-md bg-[#0f1118] border border-yellow-500/40 text-yellow-400 hover:bg-yellow-500/10 text-xs font-semibold font-mono transition-colors"
          >
            View Live Demo ↗
          </a>
        )}
      </div>
    </div>

    {/* Sequential Project Navigation (Prev / Next Case Study) */}
    <div class="pt-6 border-t border-white/10 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono">
      {prevProject ? (
        <a
          href={`/projects/${prevProject.slug}`}
          class="p-4 rounded-xl bg-[#0f1118] border border-white/10 hover:border-yellow-400 transition-colors group space-y-1 text-left"
        >
          <span class="text-slate-500 text-[11px] block">← PREVIOUS CASE STUDY</span>
          <span class="font-bold text-white group-hover:text-yellow-400 transition-colors block line-clamp-1">
            {prevProject.title}
          </span>
        </a>
      ) : <div />}

      {nextProject ? (
        <a
          href={`/projects/${nextProject.slug}`}
          class="p-4 rounded-xl bg-[#0f1118] border border-white/10 hover:border-yellow-400 transition-colors group space-y-1 text-right sm:col-start-2"
        >
          <span class="text-slate-500 text-[11px] block">NEXT CASE STUDY →</span>
          <span class="font-bold text-white group-hover:text-yellow-400 transition-colors block line-clamp-1">
            {nextProject.title}
          </span>
        </a>
      ) : <div />}
    </div>

  </article>

  {/* Interactive Dashboard Screenshot Lightbox Modal */}
  <div id="image-lightbox" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-md hidden items-center justify-center p-4 sm:p-8 transition-opacity duration-300" aria-hidden="true" role="dialog" aria-label="Dashboard Screenshot Lightbox">
    <button id="lightbox-close" class="absolute top-6 right-6 w-10 h-10 rounded-full bg-[#161924] border border-yellow-500/40 text-yellow-400 hover:text-white hover:bg-yellow-500/20 flex items-center justify-center text-lg font-mono font-bold transition-all shadow-lg cursor-pointer" aria-label="Close Lightbox (ESC)">
      ✕
    </button>
    <div class="relative max-w-5xl max-h-[90vh] flex flex-col items-center justify-center space-y-3">
      <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[80vh] object-contain rounded-lg border border-yellow-500/30 shadow-[0_0_40px_rgba(234,179,8,0.15)]" />
      <span id="lightbox-caption" class="text-xs font-mono text-slate-300 bg-[#0f1118] px-4 py-2 rounded-full border border-white/10 text-center max-w-xl"></span>
    </div>
  </div>

  <script>
    function initImageLightbox() {
      const modal = document.getElementById('image-lightbox');
      const modalImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
      const modalCaption = document.getElementById('lightbox-caption');
      const closeBtn = document.getElementById('lightbox-close');

      if (!modal || !modalImg || !modalCaption || !closeBtn) return;

      const images = document.querySelectorAll('.prose img');
      images.forEach((imgEl) => {
        const img = imgEl as HTMLImageElement;
        img.loading = 'lazy';
        img.decoding = 'async';
        img.classList.add(
          'cursor-zoom-in', 'rounded-xl', 'border', 'border-white/10',
          'bg-[#0f1118]', 'p-1.5', 'shadow-xl', 'transition-all', 'duration-300',
          'w-full', 'h-auto', 'aspect-video', 'object-cover',
          'hover:scale-[1.015]', 'hover:border-yellow-500/50', 'hover:shadow-[0_0_25px_rgba(234,179,8,0.15)]'
        );

        img.addEventListener('click', () => {
          modalImg.src = img.src;
          modalImg.alt = img.alt || 'Dashboard Screenshot';
          modalCaption.textContent = img.alt || 'Power BI Dashboard Visual';
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          modal.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        });
      });

      function closeModal() {
        if (!modal || !modalImg) return;
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        modalImg.src = '';
      }

      closeBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
          closeModal();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initImageLightbox);
    } else {
      initImageLightbox();
    }
  </script>

</BaseLayout>
